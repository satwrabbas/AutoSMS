{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "markdown",
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "android/**",
      "ios/**",
      "web/**",
      "assets/**",
      "build/**",
      ".dart_tool/**",
      ".github/**",
      ".vscode/**",
      ".run/**",
      "pubspec.lock",
      ".metadata",
      "*.svg",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.webp",
      "*.ttf",
      "*.otf"
    ]
  }
}