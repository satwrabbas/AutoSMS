192:   // ==========================================
193:   // 4. قسم السجلات 📊
194:   // ==========================================
195:   Future<List<Message>> getMessageLogs() async {
196:     return await _localStorage.getAllMessages();
197:   }
198:   Future<void> addMessageLog({required String phone, required String body, required String type}) async {
199:     // 1. الحفظ في قاعدة البيانات المحلية (Drift)
200:     await _localStorage.upsertMessage(MessagesCompanion(
201:       id: drift.Value(_uuid.v4()), // 🌟 توليد ID فريد
202:       phone: drift.Value(phone), 
203:       body: drift.Value(body), 
204:       type: drift.Value(type), 
205:       messageDate: drift.Value(DateTime.now()), 
206:     ));
207:     // 2. 🚀 الرفع التلقائي للسحابة فوراً (لكي لا تضيع الرسالة)
208:     try {
209:       // نستدعي دالة المزامنة الشاملة لرفع هذا السجل الجديد
210:       await syncAllToCloud(); 
211:     } catch (e) {
212:       // في حال عدم وجود إنترنت وقت إرسال الـ SMS، ستبقى محفوظة محلياً
213:       // وسيتم رفعها لاحقاً عند فتح التطبيق
214:       print('تم حفظ الرسالة محلياً، سيتم رفعها لاحقاً لعدم توفر اتصال: $e');
215:     }
216:   }
217:   // ==========================================
218:   // 5. قسم المزامنة الشاملة ☁️
219:   // ==========================================
220:   Future<void> saveFcmToken(String token) async {
221:     // هذه الدالة تم حذفها سابقاً، يمكن إزالتها أو تركها فارغة، لأننا نعتمد على registerDevice
222:   }
223:   Future<void> syncAllToCloud() async {
224:     // 🌟 السحر: لكي نفهم الحذف الناعم، نطلب من قاعدة البيانات جلب (كل شيء) بما فيه المحذوف!
225:     // لو استخدمنا getAllContacts العادية، كانت ستخفي العملاء المحذوفين ولن يتم رفعهم للسحابة
226:     final groups = await _localStorage.select(_localStorage.groups).get();
227:     final contacts = await _localStorage.select(_localStorage.contacts).get();
228:     final schedules = await _localStorage.select(_localStorage.schedules).get();
229:     final messages = await _localStorage.select(_localStorage.messages).get(); 
230:     // 🌟 أضفنا حقل is_deleted لكي تعرف السحابة أننا قمنا בחذف شيء ما محلياً
231:     final groupsJson = groups.map((g) => {'id': g.id, 'name': g.name, 'is_deleted': g.isDeleted}).toList();
232:     final contactsJson = contacts.map((c) => {'id': c.id, 'name': c.name, 'phone': c.phone, 'group_id': c.groupId, 'is_deleted': c.isDeleted}).toList();
233:     final schedulesJson = schedules.map((s) => {
234:       'id': s.id,
235:       'group_id': s.groupId,
236:       'message': s.message,
237:       'send_day': s.sendDay,
238:       'send_hour': s.sendHour,
239:       'send_minute': s.sendMinute,
240:       'target_device_id': s.targetDeviceId, 
241:       'is_active': s.isActive, 
242:       'is_deleted': s.isDeleted // 🌟
243:     }).toList();
244:     final messagesJson = messages.map((m) => {'id': m.id, 'phone': m.phone, 'body': m.body, 'type': m.type, 'message_date': m.messageDate.toIso8601String()}).toList();
245:     await _cloudStorage.syncGroups(groupsJson);
246:     await _cloudStorage.syncContacts(contactsJson);
247:     await _cloudStorage.syncSchedules(schedulesJson);
248:     await _cloudStorage.syncMessages(messagesJson);
249:     await _cloudStorage.updateCloudSyncTime();
250:     final prefs = await SharedPreferences.getInstance();
251:     await prefs.setString('local_sync_time', DateTime.now().toUtc().toIso8601String());
252:   }
253:   Future<void> downloadAllFromCloud() async {
254:     final cloudGroups = await _cloudStorage.fetchGroups();
255:     final cloudContacts = await _cloudStorage.fetchContacts();
256:     final cloudSchedules = await _cloudStorage.fetchSchedules();
257:     final cloudMessages = await _cloudStorage.fetchMessages();
258:     // 🌟 نقرأ حقل is_deleted القادم من السحابة ونحفظه محلياً ليختفي العنصر من الواجهة
259:     for (var row in cloudGroups) {
260:       try { await _localStorage.upsertGroup(GroupsCompanion(id: drift.Value(row['id'].toString()), name: drift.Value(row['name']), isDeleted: drift.Value(row['is_deleted'] ?? false))); } catch (_) {} 
261:     }
262:     for (var row in cloudContacts) {
263:       try { await _localStorage.upsertContact(ContactsCompanion(id: drift.Value(row['id'].toString()), name: drift.Value(row['name']), phone: drift.Value(row['phone']), groupId: drift.Value(row['group_id']?.toString()), isDeleted: drift.Value(row['is_deleted'] ?? false))); } catch (_) {}
264:     }
265:     for (var row in cloudSchedules) {
266:       try {
267:         await _localStorage.upsertSchedule(SchedulesCompanion(
268:           id: drift.Value(row['id'].toString()),
269:           groupId: drift.Value(row['group_id'].toString()),
270:           message: drift.Value(row['message']),
271:           sendHour: drift.Value(row['send_hour'] ?? 9),
272:           sendMinute: drift.Value(row['send_minute'] ?? 0),
273:           sendDay: drift.Value(row['send_day']),
274:           targetDeviceId: drift.Value(row['target_device_id']?.toString()), 
275:           lastSentDate: drift.Value(row['last_sent_date'] != null ? DateTime.parse(row['last_sent_date']) : null),
276:           isActive: drift.Value(row['is_active']),
277:           isDeleted: drift.Value(row['is_deleted'] ?? false), // 🌟
278:         ));
279:       } catch (_) {}
280:     }
281:     for (var row in cloudMessages) {
282:       try { await _localStorage.upsertMessage(MessagesCompanion(id: drift.Value(row['id'].toString()), phone: drift.Value(row['phone']), body: drift.Value(row['body']), type: drift.Value(row['type']), messageDate: drift.Value(DateTime.parse(row['message_date'])))); } catch (_) {}
283:     }
284:   }
285:   Future<bool> downloadIfCloudIsNewer() async {
286:     final cloudTime = await _cloudStorage.getCloudSyncTime();
287:     if (cloudTime == null) return false;
288:     final prefs = await SharedPreferences.getInstance();
289:     final localTimeString = prefs.getString('local_sync_time');
290:     DateTime? localTime;
291:     if (localTimeString != null) localTime = DateTime.parse(localTimeString);
292:     if (localTime == null || cloudTime.isAfter(localTime)) {
293:       // ✅ نكتفي بالتنزيل، ودوال הـ Upsert في Drift ستتكفل بدمج البيانات دون حذف رسائلنا الجديدة
294:       await downloadAllFromCloud(); 
295:       await prefs.setString('local_sync_time', cloudTime.toIso8601String());
296:       return true; 
297:     }
298:     return false; 
299:   }
300: }
