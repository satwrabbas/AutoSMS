 2: import { createClient } from 'npm:@supabase/supabase-js@2'
 3: import { initializeApp, cert } from 'npm:firebase-admin/app'
 4: import { getMessaging } from 'npm:firebase-admin/messaging'
 5: // 1. تهيئة الاتصال بفايربيس باستخدام المفتاح السري الذي رفعناه
 6: const serviceAccountStr = Deno.env.get('FIREBASE_SERVICE_ACCOUNT');
 7: if (serviceAccountStr) {
 8:   const serviceAccount = JSON.parse(serviceAccountStr);
 9:   try {
10:     initializeApp({ credential: cert(serviceAccount) });
11:   } catch (e) {} // تجاهل إذا تم التهيئة مسبقاً
12: }
13: serve(async (req) => {
14:   try {
15:     // 2. الاتصال بقاعدة بيانات Supabase الخاصة بك
16:     const supabase = createClient(
17:       Deno.env.get('SUPABASE_URL') ?? '',
18:       Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? '' // Service Role لتخطي حماية RLS
19:     );
20:     // 🌟 3. السحر الزمني: تحويل توقيت سيرفرات أمريكا (UTC) إلى توقيت دمشق (UTC+3)
21:     const nowUtc = new Date();
22:     const damascusOffset = 3 * 60 * 60 * 1000; // 3 ساعات بالمللي ثانية
23:     // نضيف 3 ساعات للوقت الحالي لنحصل على وقت دمشق
24:     const damascusTime = new Date(nowUtc.getTime() + damascusOffset);
25:     // نستخدم getUTC لنستخرج اليوم والساعة والدقيقة بعد الإزاحة
26:     const currentDay = damascusTime.getUTCDate();
27:     const currentHour = damascusTime.getUTCHours();
28:     const currentMinute = damascusTime.getUTCMinutes();
29:     console.log(`جارٍ الفحص بتوقيت دمشق: يوم ${currentDay} - الساعة ${currentHour}:${currentMinute}`);
30:     // 🌟 4. البحث الدقيق عن الحملات المجدولة لليوم، ونفس الساعة، ونفس الدقيقة!
31:     const { data: schedules } = await supabase
32:       .from('schedules')
33:       .select('*')
34:       .eq('send_day', currentDay)
35:       .eq('send_hour', currentHour)
36:       .eq('send_minute', currentMinute)
37:       .eq('is_active', true);
38:     if (!schedules || schedules.length === 0) {
39:       return new Response(`لا توجد حملات لهذه الدقيقة (${currentHour}:${currentMinute}).`, { status: 200 });
40:     }
41:     // 5. جلب مفاتيح هواتف المستخدمين (FCM Tokens)
42:     const userIds = schedules.map(s => s.user_id);
43:     const { data: tokens } = await supabase
44:       .from('user_tokens')
45:       .select('*')
46:       .in('user_id', userIds);
47:     const tokenMap: Record
                                                                        <string, string> = {};
48:     tokens?.forEach(t => tokenMap[t.user_id] = t.fcm_token);
49:     let sentCount = 0;
50:     // 6. إرسال أوامر الاستيقاظ (Silent Push) للهواتف
51:     for (const schedule of schedules) {
52:       // التأكد من أنها لم تُرسل مسبقاً هذا الشهر
53:       let alreadySentThisMonth = false;
54:       if (schedule.last_sent_date) {
55:         const lastSent = new Date(schedule.last_sent_date);
56:         if (lastSent.getUTCMonth() === damascusTime.getUTCMonth() && lastSent.getUTCFullYear() === damascusTime.getUTCFullYear()) {
57:           alreadySentThisMonth = true;
58:         }
59:       }
60:       if (!alreadySentThisMonth) {
61:         const fcmToken = tokenMap[schedule.user_id];
62:         if (fcmToken) {
63:           // إرسال الإشارة الصامتة للهاتف
64:           await getMessaging().send({
65:             token: fcmToken,
66:             data: {
67:               group_id: schedule.group_id.toString(),
68:               message: schedule.message
69:             }
70:           });
71:           // تحديث تاريخ آخر إرسال في السحابة لمنع التكرار
72:           await supabase
73:             .from('schedules')
74:             .update({ last_sent_date: nowUtc.toISOString() }) // نحفظ الوقت الأصلي كمعيار قياسي
75:             .eq('id', schedule.id);
76:            // 🌟 السطر الجديد: إخبار دفتر التحديثات أن السحابة قامت بتعديل بيانات هذا المستخدم!
77:           await supabase
78:             .from('sync_metadata')
79:             .upsert({ 
80:                user_id: schedule.user_id, 
81:                last_updated_at: nowUtc.toISOString() 
82:             });
83:           sentCount++;
84:         }
85:       }
86:     }
87:     return new Response(`تم الإرسال بنجاح! أيقظنا ${sentCount} هواتف.`, { status: 200 });
88:   } catch (error: any) {
89:     return new Response(`خطأ: ${error.message}`, { status: 500 });
90:   }
91: });
