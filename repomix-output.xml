 4: part 'login_state.dart';
 5: class LoginCubit extends Cubit<LoginState> {
 6:   LoginCubit({required CrmRepository repository})
 7:       : _repository = repository,
 8:         super(LoginInitial());
 9:   final CrmRepository _repository;
10:   Future<void> signIn({required String email, required String password}) async {
11:     emit(LoginLoading());
12:     try {
13:       await _repository.signIn(email: email, password: password);
14:       emit(LoginSuccess());
15:     } catch (e) {
16:       emit(LoginError(message: _translateError(e)));
17:     }
18:   }
19:   Future<void> signUp({required String email, required String password}) async {
20:     emit(LoginLoading());
21:     try {
22:       await _repository.signUp(email: email, password: password);
23:       emit(LoginSuccess());
24:     } catch (e) {
25:       emit(LoginError(message: _translateError(e)));
26:     }
27:   }
28:   String _translateError(Object e) {
29:     final errorStr = e.toString().toLowerCase();
30:     if (errorStr.contains('socket') || 
31:         errorStr.contains('host lookup') || 
32:         errorStr.contains('network') || 
33:         errorStr.contains('connection') ||
34:         errorStr.contains('xmlhttprequest') || 
35:         errorStr.contains('clientexception')) {
36:       return 'errorNoInternet';
37:     }
38:     if (e is AuthException) {
39:       if (errorStr.contains('invalid login credentials')) {
40:         return 'errorInvalidCredentials';
41:       }
42:       if (errorStr.contains('user already registered')) {
43:         return 'errorUserAlreadyRegistered';
44:       }
45:       if (errorStr.contains('password should be at least')) {
46:         return 'errorWeakPassword';
47:       }
48:       if (errorStr.contains('rate limit')) {
49:         return 'errorRateLimit';
50:       }
51:       return e.message; 
52:     }
53:     return 'errorUnexpected';
54:   }
55: }
